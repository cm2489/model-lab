    {
      "id": "lab-0.c1",
      "lab": "lab-0",
      "after_step": "lab-0.2",
      "concept": "quantization",
      "type": "core",
      "front": "What does 4-bit quantization trade away to fit a model in less memory?",
      "back": "Some accuracy: each weight is stored with fewer bits, so values are rounded."
    },
    {
      "id": "lab-0.c2",
      "lab": "lab-0",
      "after_step": "lab-0.3",
      "concept": "tokens per second",
      "type": "core",
      "front": "Which number tells you how fast a model generates text on your Mac?",
      "back": "Tokens per second during generation, measured after the prompt is processed."
    },
    {
      "id": "lab-0.c3",
      "lab": "lab-0",
      "after_step": "lab-0.3",
      "concept": "unified memory",
      "type": "core",
      "front": "Why can an M1 Max run models that a 16 GB GPU cannot?",
      "back": "The GPU shares the 32 GB of unified memory with the CPU."
    },
    {
      "id": "lab-1.c1",
      "lab": "lab-1",
      "after_step": "lab-1.2",
      "concept": "golden set",
      "type": "core",
      "front": "What is a golden set?",
      "back": "A fixed, hand-checked set of inputs and correct labels used to score every model the same way."
    },
    {
      "id": "lab-1.c2",
      "lab": "lab-1",
      "after_step": "lab-1.3",
      "concept": "baseline",
      "type": "core",
      "front": "Why score the base model before any fine-tuning?",
      "back": "It is the baseline: without it you cannot show that tuning helped."
    },
    {
      "id": "lab-1.c3",
      "lab": "lab-1",
      "after_step": "lab-1.5",
      "concept": "error analysis",
      "type": "core",
      "front": "What do you look for when you read 30 failures?",
      "back": "Patterns: which labels get confused and why, so you fix the cause, not one case."
    },
    {
      "id": "lab-1.c4",
      "lab": "lab-1",
      "after_step": "lab-1.6",
      "concept": "regression gate",
      "type": "core",
      "front": "What does a pass/fail gate in CI protect against?",
      "back": "A change that quietly makes the model worse than the agreed bar."
    },
    {
      "id": "lab-2.c1",
      "lab": "lab-2",
      "after_step": "lab-2.1",
      "concept": "LoRA",
      "type": "core",
      "front": "What does LoRA train instead of the full weights?",
      "back": "Small low-rank matrices added beside chosen layers; the original weights stay frozen."
    },
